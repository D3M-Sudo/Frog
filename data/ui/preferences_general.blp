using Gtk 4.0;
using Adw 1;

translation-domain 'io.github.d3msudo.anura';

template $PreferencesGeneralPage : Adw.PreferencesPage {
  title: _("_General");
  use-underline: true;
  icon-name: "emblem-system-symbolic";

  Adw.PreferencesGroup {
    title: _("Appearance");

    Adw.ComboRow color_scheme_combo {
      title: _("Color Scheme");
      subtitle: _("The preferred color scheme for the application.");
    }
  }

  Adw.PreferencesGroup {
    title: _("Text Extraction");

    Adw.ComboRow extra_language_combo {
      title: _("_Secondary Language");
      use-underline: true;
      subtitle: _("Additional language used in text recognition");
    }

    Adw.SwitchRow magic_processor_switch {
      title: _("Smart Text Parsing");
      subtitle: _("Automatically reformat URLs, emails and paragraphs");
    }
  }

  Adw.PreferencesGroup {
    title: _("Behavior");

    Adw.SwitchRow autocopy_switch {
      title: _("_Copy to Clipboard");
      use-underline: true;
      subtitle: _("Automatically copy the extracted text after detection");
    }

    Adw.SwitchRow autolinks_switch {
      title: _("_Open QR-code Links");
      use-underline: true;
      subtitle: _("Open QR code URLs directly in browser. Otherwise, a clickable notification is shown.");
    }

    // NOTE: telemetry_switch has been removed from this template.
    // The Python widget (PreferencesGeneralPage) previously declared it as a
    // Gtk.Template.Child() and then set it invisible — causing a template
    // mismatch warning if the widget was absent from the .ui file.
    // Since telemetry is fully disabled in Anura, the widget is simply gone.
  }

  Adw.PreferencesGroup {
    title: _("History");

    Adw.SwitchRow history_switch {
      title: _("Save Extraction History");
      subtitle: _("Keep a local list of recently extracted texts");
    }

    Adw.SpinRow history_limit_row {
      title: _("History Size");
      subtitle: _("Maximum number of entries kept in history");
      adjustment: Adjustment {
        lower: 1.0;
        upper: 500.0;
        step-increment: 1.0;
      };
    }
  }

  Adw.PreferencesGroup {
    title: _("Editor");

    Adw.SwitchRow editor_line_numbers_switch {
      title: _("Show Line Numbers");
      subtitle: _("Display line numbers along the edge of the editor");
    }

    Adw.SwitchRow editor_highlight_line_switch {
      title: _("Highlight Current Line");
      subtitle: _("Highlight the active line containing cursor");
    }

    Adw.ComboRow editor_wrap_mode_combo {
      title: _("Word Wrap Mode");
      subtitle: _("Policy for wrapping long lines of text");
    }
  }

  Adw.PreferencesGroup {
    title: _("Text-to-Speech");

    Adw.SpinRow volume_row {
      title: _("Volume");
      subtitle: _("TTS playback volume level (0-100%)");
      adjustment: Adjustment {
        lower: 0.0;
        upper: 100.0;
        step-increment: 10.0;
      };
    }

    Adw.ComboRow tts_language_combo {
      title: _("TTS Language");
      subtitle: _("Language for speech synthesis. Uses OCR language if not set.");
    }
  }
}
