using Gtk 4.0;
using Adw 1;
using GtkSource 5;

translation-domain 'io.github.d3msudo.anura';

template $ExtractedPage : Adw.NavigationPage {
  title: _("Extracted");
  styles ["extracted-page"]

  Adw.ToolbarView {

    [top]
    Adw.HeaderBar headerbar {

      [start]
      Adw.SplitButton grab_btn {
        action-name: "app.get_screenshot";
        tooltip-text: _("Take a Screenshot (Ctrl+G)");
        accessibility {
          label: _("Take a screenshot");
        }
        icon-name: "camera-photo-symbolic";
        menu-model: grab_menu;
      }

      [start]
      Button text_copy_btn {
        action-name: "app.copy_to_clipboard";
        tooltip-text: C_("Extracted screen", "Copy Extracted Text to Clipboard (Ctrl+C)");
        accessibility {
          label: C_("Extracted screen", "Copy extracted text to clipboard");
        }
        icon-name: "edit-copy-symbolic";
        styles ["anura-button"]
      }

      [start]
      Button undo_btn {
        tooltip-text: C_("Extracted screen", "Undo (Ctrl+Z)");
        accessibility {
          label: C_("Extracted screen", "Undo");
        }
        icon-name: "edit-undo-symbolic";
        styles ["anura-button"]
      }

      [start]
      Button redo_btn {
        tooltip-text: C_("Extracted screen", "Redo (Ctrl+Shift+Z)");
        accessibility {
          label: C_("Extracted screen", "Redo");
        }
        icon-name: "edit-redo-symbolic";
        styles ["anura-button"]
      }

      [start]
      ToggleButton search_button {
        tooltip-text: C_("Extracted screen", "Search Text (Ctrl+F)");
        accessibility {
          label: C_("Extracted screen", "Search text");
        }
        icon-name: "edit-find-symbolic";
        styles ["anura-button"]
      }

      [start]
      Stack listen_stack {
        transition-type: crossfade;

        StackPage {
          name: "button";
          child: Button listen_btn {
            action-name: "app.listen";
            tooltip-text: C_("Extracted screen", "Listen to Text (Ctrl+L)");
            accessibility {
              label: C_("Extracted screen", "Listen to text");
            }
            icon-name: "audio-speakers-symbolic";
            styles ["anura-button"]
          };
        }

        StackPage {
          name: "cancel";
          child: Button listen_cancel_btn {
            action-name: "app.listen_cancel";
            tooltip-text: C_("Extracted screen", "Stop listening (Ctrl+Shift+L)");
            accessibility {
              label: C_("Extracted screen", "Stop listening");
            }
            icon-name: "media-playback-stop-symbolic";
            styles ["anura-button"]
          };
        }

        StackPage {
          name: "spinner";
          child: Gtk.Spinner listen_spinner {
            halign: center;
            valign: center;
            accessibility {
              label: _("Generating audio");
            }
          };
        }

        StackPage {
          name: "pause";
          child: Box {
            styles ["linked"]

            Button listen_pause_btn {
              action-name: "app.listen_pause";
              tooltip-text: C_("Extracted screen", "Pause/Resume listening (Ctrl+Alt+L)");
              accessibility {
                label: C_("Extracted screen", "Pause or resume listening");
              }
              icon-name: "media-playback-pause-symbolic";
              styles ["anura-button"]
            }

            Button {
              action-name: "app.listen_cancel";
              tooltip-text: C_("Extracted screen", "Stop listening (Ctrl+Shift+L)");
              accessibility {
                label: C_("Extracted screen", "Stop listening");
              }
              icon-name: "media-playback-stop-symbolic";
              styles ["anura-button"]
            }
          };
        }
      }

      [end]
      MenuButton {
        icon-name: "open-menu-symbolic";
        tooltip-text: C_("Extracted screen", "Open menu");
        accessibility {
          label: C_("Extracted screen", "Open menu");
        }
        menu-model: primary_menu;
      }

      [end]
      MenuButton share_button {
        icon-name: "emblem-shared-symbolic";
        tooltip-text: C_("Extracted screen", "Share To");
        accessibility {
          label: C_("Extracted screen", "Share text to other applications");
        }
        popover: Popover {

          styles ["menu"]

          child: ListBox share_list_box {
            accessibility {
              label: _("Share providers");
            }
            margin-end: 4;
            margin-top: 4;
            margin-start: 4;
            margin-bottom: 4;
          };
        };
      }
    }

    [top]
    SearchBar search_bar {
      key-capture-widget: text_view;

      child: Box {
        styles ["linked"]
        margin-start: 12;
        margin-end: 12;
        margin-top: 6;
        margin-bottom: 6;

        SearchEntry search_entry {
          hexpand: true;
          placeholder-text: _("Search text…");
          accessibility {
            label: _("Search extracted text");
          }
        }

        Label search_count_label {
          styles ["dim-label"]
          margin-start: 6;
          margin-end: 8;
        }

        ToggleButton search_case_btn {
          icon-name: "format-text-capitalize-symbolic";
          tooltip-text: _("Match Case");
          accessibility {
            label: _("Match Case");
          }
        }

        Button search_prev_btn {
          icon-name: "go-up-symbolic";
          tooltip-text: _("Previous Match (Shift+Enter)");
          accessibility {
            label: _("Previous match");
          }
        }

        Button search_next_btn {
          icon-name: "go-down-symbolic";
          tooltip-text: _("Next Match (Enter)");
          accessibility {
            label: _("Next match");
          }
        }
      };
    }

    ScrolledWindow text_scrollview {
      hexpand: true;
      vexpand: true;
      hscrollbar-policy: never;
      propagate-natural-width: false;
      width-request: 150; // Consente il rimpicciolimento fluido sotto la dimensione ideale del testo

      GtkSource.View text_view {
        accessibility {
          label: _("Extracted text editing buffer");
        }
        hexpand: true;
        vexpand: true;
        width-request: 100;
        wrap-mode: word; // Sostituisce word_char per evitare di troncare le parole a metà

        // Margini interni nativi di GtkTextView per il testo
        left-margin: 14;
        right-margin: 14;
        top-margin: 12;
        bottom-margin: 12;
        pixels-above-lines: 4;
        pixels-below-lines: 4;

        buffer: GtkSource.Buffer buffer {
          enable-undo: true;
        };
      }
    }

    [bottom]
    Box {
      styles ["footer"]

      Label transformer_label {
        halign: start;
        hexpand: true;
        margin-start: 12;
        margin-top: 6;
        margin-bottom: 6;
        styles ["dim-label", "caption", "anura-fade-in"]
        accessibility {
          label: _("Applied smart transformation");
        }
      }

      Label stats_label {
        halign: end;
        hexpand: true;
        margin-end: 12;
        margin-top: 6;
        margin-bottom: 6;
        styles ["dim-label"]
        accessibility {
          label: _("Text statistics");
        }
      }
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("Open in External Editor");
      action: "app.open_external_editor";
      icon: "document-open-symbolic";
    }

    item {
      label: _("Preferences");
      action: "app.preferences";
      icon: "preferences-system-symbolic";
    }
  }

  section {
    item {
      label: _("Keyboard Shortcuts");
      action: "app.shortcuts";
      icon: "preferences-desktop-keyboard-shortcuts-symbolic";
    }

    item {
      label: _("About Anura");
      action: "app.about";
      icon: "help-about-symbolic";
    }

    item {
      label: _("Report an Issue");
      action: "app.report_issue";
      icon: "dialog-warning-symbolic";
    }
  }
}


menu grab_menu {
    item (_("Open image"), "app.open_image", "folder-open-symbolic")
    item (_("Paste from clipboard"), "app.paste_from_clipboard", "edit-paste-symbolic")
}
