using Gtk 4.0;
using Adw 1;

translation-domain 'io.github.d3msudo.anura';

template $WelcomePage : Adw.NavigationPage {
  title: _("Welcome");

  Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        visible: true;
        
        [title]
        Adw.WindowTitle {
          title: _("Anura");
        }

        [start]
        MenuButton lang_combo {
          label: _("_Language");
          use-underline: true;
          tooltip-text: _("Select language to extract");
          popover: $LanguagePopover language_popover {};
        }

        [start]
        Gtk.Spinner spinner {
          visible: false;
          accessibility {
            label: _("Extracting text");
          }
        }

        [end]
        MenuButton {
          icon-name: "open-menu-symbolic";
          menu-model: primary_menu;
          tooltip-text: _("Open menu");
          accessibility {
            label: _("Open menu");
          }
        }
      }

      Adw.StatusPage welcome {
        title: _("Anura");
        description: _("Extract text from anywhere");
        icon-name: "io.github.d3msudo.anura";

        Adw.Clamp {
          maximum-size: 240;
          child: Box {
            orientation: vertical;
            spacing: 12;

            Button screenshot_button {
              action-name: "app.get_screenshot";
              tooltip-text: C_("Welcome screen", "Take a Screenshot (Ctrl+G)");
              accessibility {
                label: C_("Welcome screen", "Take a Screenshot");
              }
              styles ["pill", "suggested-action", "anura-button"]
              
              child: Box {
                halign: center;
                spacing: 6;
                Image { icon-name: "camera-photo-symbolic"; }
                Label {
                  label: _("_Take a Screenshot");
                  use-underline: true;
                }
              };
            }

            Button {
              action-name: "app.open_image";
              tooltip-text: C_("Welcome screen", "Open Image (Ctrl+O)");
              accessibility {
                label: C_("Welcome screen", "Open Image");
              }
              styles ["pill", "anura-button"]

              child: Box {
                halign: center;
                spacing: 6;
                Image { icon-name: "folder-open-symbolic"; }
                Label {
                  label: _("_Open Image");
                  use-underline: true;
                }
              };
            }

             Button {
              action-name: "app.paste_from_clipboard";
              tooltip-text: C_("Welcome screen", "Paste Image from Clipboard (Ctrl+V)");
              accessibility {
                label: C_("Welcome screen", "Paste Image");
              }
              styles ["pill", "anura-button"]

              child: Box {
                halign: center;
                spacing: 6;
                Image { icon-name: "edit-paste-symbolic"; }
                Label {
                  label: _("_Paste Image");
                  use-underline: true;
                }
              };
            }

            Button drop_button {
              tooltip-text: C_("Welcome screen", "Drop image here");
              accessibility {
                label: C_("Welcome screen", "Drop image here");
              }
              styles ["pill", "anura-button"]

              child: Box {
                halign: center;
                spacing: 6;
                Image { icon-name: "folder-drag-accept-symbolic"; }
                Label {
                  label: _("_Drop Image");
                  use-underline: true;
                }
              };
            }

            Revealer drop_revealer {
              transition-type: slide_up;
              reveal-child: false;

              Box drop_area {
                margin-top: 12;
                styles ["card", "anura-slide-up"]
                height-request: 80;
                halign: fill;
                valign: center;
                focusable: true;
                accessibility {
                  label: _("Image drop zone");
                }
                Label drop_area_label {
                  label: _("Drop image file here");
                  halign: center;
                  valign: center;
                  hexpand: true;
                  vexpand: true;
                  styles ["dim-label"]
                }
              }
            }
          };
        }
      }
  }
}

menu primary_menu {
  section {
    item {
      label: _("History");
      action: "win.show-history";
      icon: "document-open-recent-symbolic";
    }

    item {
      label: _("Preferences");
      action: "app.preferences";
      icon: "preferences-system-symbolic";
    }
  }

  section {
    item {
      label: _("Keyboard Shortcuts");
      action: "app.shortcuts";
      icon: "preferences-desktop-keyboard-shortcuts-symbolic";
    }

    item {
      label: _("About Anura");
      action: "app.about";
      icon: "help-about-symbolic";
    }

    item {
      label: _("Report an Issue");
      action: "app.report_issue";
      icon: "dialog-warning-symbolic";
    }
  }

  section {
    item {
      label: _("⭐ Star on GitHub");
      action: "app.github_star";
    }
  }
}